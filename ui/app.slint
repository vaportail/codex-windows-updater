// Installer wizard. Single window, screen switched by `current-screen`.
// Proxy mode reuses this window but stays on `current-screen == 10` (status).
//
// Screen IDs:
//   0 Welcome       3 Options
//   1 Mode          4 Progress
//   2 Path          5 Done        6 Error
//  10 Proxy status
//  11 Checking for updates (splash)
//  12 Update available (confirm + defer options)
//  13 Up to date (brief confirmation)
//  20 Uninstall confirm
//  21 Uninstall progress   (reuses progress-phase/progress-detail/progress-*)
//  22 Uninstall done
//  23 Uninstall error/refused
//  30 Launcher update prompt
//  31 Launcher self-update done (restart-to-apply notice)

import { VerticalBox, HorizontalBox, Button, LineEdit, CheckBox, ComboBox } from "std-widgets.slint";

component DarkButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> disabled: false;
    callback clicked;
    height: 36px;
    min-width: 96px;
    border-radius: 4px;
    background: ta.has-hover && !root.disabled
        ? (root.primary ? #89b4fa : #45475a)
        : (root.primary ? #74c7ec : #313244);
    opacity: root.disabled ? 0.5 : 1.0;
    // HorizontalLayout drives the Rectangle's preferred width from the
    // Text's measured size + padding. Without a layout the Text is overlaid
    // and `min-width: 96px` is the only width source — wider labels clip.
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: root.primary ? #11111b : #cdd6f4;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

component ModeCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> selected: false;
    callback clicked;
    height: 58px;
    border-radius: 6px;
    border-width: 2px;
    border-color: root.selected ? #89b4fa : (ta.has-hover ? #45475a : #313244);
    background: ta.has-hover ? #26263a : #181825;
    VerticalBox {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 2px;
        Text {
            text: root.title;
            color: #cdd6f4;
            font-size: 14px;
            font-weight: 600;
        }
        Text {
            text: root.subtitle;
            color: #a6adc8;
            font-size: 11px;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    // Wizard state (bound both ways — UI writes, Rust reads at install time).
    in-out property <int> current-screen: 0;
    in-out property <int> install-mode: 1; // 0=portable 1=user 2=system
    in-out property <string> install-path;
    in-out property <bool> create-shortcut: true;
    in-out property <bool> register-uninstall: true;
    in-out property <bool> use-current-junction: true;
    in-out property <int> keep-versions: 2;
    in-out property <int> fetcher: 0; // 0=direct 1=winget

    // Progress / status (Rust writes, UI reads).
    in property <string> progress-phase: "";
    in property <string> progress-detail: "";
    in property <float> progress-fraction: 0.0;
    in property <bool> progress-indeterminate: false;
    in property <string> error-text: "";
    in property <string> installed-version: "";

    // Proxy-mode status (screen 10).
    in property <string> proxy-status: "";

    // Update flow (screens 11/12/13).
    in property <string> update-current-version: "";
    in property <string> update-latest-version: "";
    in property <string> update-error-text: "";

    // Uninstall flow (screens 20/21/22/23).
    in property <string> uninstall-log-path: "";

    // Launcher self-update prompt (screen 30).
    in property <string> launcher-current-version: "";
    in property <string> launcher-latest-version: "";
    // Empty means "no launcher update pending"; non-empty is the URL to open
    // when the user clicks "View release".
    in property <string> launcher-release-url: "";

    // Callbacks to Rust.
    callback request-install();
    callback request-cancel();
    callback request-launch();
    callback request-quit();
    callback mode-selected(int);
    callback path-browse();
    // Update-flow callbacks. defer-choice encodes: 0=UpdateNow, 1=NotNow,
    // 2=SkipThisVersion, 3=SnoozeOneDay, 4=SnoozeSevenDays, 5=Never.
    callback request-update(int);
    callback request-check-updates();
    callback request-uninstall-start();
    // Launcher prompt callbacks. action encodes: 0=ViewRelease (doesn't dismiss),
    // 1=NotNow, 2=SkipThisVersion, 3=SnoozeOneDay, 4=SnoozeSevenDays, 5=Never,
    // 6=ApplyUpdate (download + replace running launcher).
    callback request-launcher-action(int);

    title: "Codex Updater";
    width: 580px;
    height: 420px;
    background: #1e1e2e;
    default-font-family: "Segoe UI";
    // Launcher reminder is shown after Codex is launched/focused, which
    // would otherwise bury it. Pin only on screen 30 so other screens
    // behave normally.
    always-on-top: current-screen == 30 || current-screen == 31;

    VerticalBox {
        padding: 24px;
        spacing: 14px;

        // Header
        HorizontalBox {
            padding: 0px;
            Text {
                text: "Codex Updater";
                font-size: 20px;
                font-weight: 700;
                color: #cdd6f4;
            }
            Rectangle {} // spacer
            Text {
                text: root.current-screen == 10 ? "" :
                      root.current-screen == 11 ? "Checking for updates" :
                      root.current-screen == 12 ? "Update available" :
                      root.current-screen == 13 ? "Up to date" :
                      root.current-screen == 20 ? "Uninstall Codex" :
                      root.current-screen == 21 ? "Uninstalling…" :
                      root.current-screen == 22 ? "Uninstall complete" :
                      root.current-screen == 23 ? "Uninstall failed" :
                      root.current-screen == 30 ? "Launcher update available" :
                      root.current-screen == 31 ? "Launcher updated" :
                      root.current-screen == 0 ? "Welcome" :
                      root.current-screen == 1 ? "Step 1 / 3" :
                      root.current-screen == 2 ? "Step 2 / 3" :
                      root.current-screen == 3 ? "Step 3 / 3" :
                      root.current-screen == 4 ? "Working…" :
                      root.current-screen == 5 ? "Done" : "Error";
                color: #6c7086;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        Rectangle { height: 1px; background: #313244; }

        // Body (screen-specific)
        Rectangle {
            vertical-stretch: 1;

            // Welcome
            if root.current-screen == 0 : VerticalBox {
                spacing: 10px;
                Text {
                    text: "Unofficial installer for the OpenAI Codex desktop app.";
                    color: #cdd6f4;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Downloads the official Microsoft Store package directly and extracts it — no Store app required.";
                    color: #a6adc8;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { height: 8px; }
                Text { text: "Click Next to choose where to install."; color: #a6adc8; font-size: 12px; }
            }

            // Mode
            if root.current-screen == 1 : VerticalBox {
                spacing: 8px;
                Text {
                    text: "Where should Codex be installed?";
                    color: #cdd6f4;
                    font-size: 14px;
                }
                ModeCard {
                    title: "Portable";
                    subtitle: "Self-contained folder. No registry, no shortcuts unless you add them.";
                    selected: root.install-mode == 0;
                    clicked => { root.install-mode = 0; root.mode-selected(0); }
                }
                ModeCard {
                    title: "User install  (recommended)";
                    subtitle: "%LOCALAPPDATA%\\Codex — no admin required.";
                    selected: root.install-mode == 1;
                    clicked => { root.install-mode = 1; root.mode-selected(1); }
                }
                ModeCard {
                    title: "System install";
                    subtitle: "C:\\Program Files\\Codex — requires admin, shared across users.";
                    selected: root.install-mode == 2;
                    clicked => { root.install-mode = 2; root.mode-selected(2); }
                }
            }

            // Path
            if root.current-screen == 2 : VerticalBox {
                spacing: 8px;
                Text { text: "Install location"; color: #cdd6f4; font-size: 14px; }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    LineEdit {
                        text <=> root.install-path;
                        horizontal-stretch: 1;
                    }
                    DarkButton { text: "Browse…"; clicked => { root.path-browse(); } }
                }
                Text {
                    text: "A `versions/` subdirectory will hold each installed MSIX version. The launcher sits at the root and re-launches the newest version.";
                    color: #6c7086;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }

            // Options
            if root.current-screen == 3 : VerticalBox {
                spacing: 12px;
                Text { text: "Options"; color: #cdd6f4; font-size: 14px; }

                CheckBox { text: "Create Start Menu shortcut"; checked <=> root.create-shortcut; }
                CheckBox {
                    text: "Register in Add/Remove Programs (enables one-click uninstall)";
                    checked <=> root.register-uninstall;
                }
                CheckBox {
                    text: "Maintain versions/current junction (recommended)";
                    checked <=> root.use-current-junction;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text { text: "Keep previous versions:"; color: #cdd6f4; vertical-alignment: center; }
                    ComboBox {
                        model: ["1", "2", "3", "5"];
                        current-index: root.keep-versions == 1 ? 0 : root.keep-versions == 2 ? 1 : root.keep-versions == 3 ? 2 : 3;
                        selected(v) => {
                            root.keep-versions = v == "1" ? 1 : v == "2" ? 2 : v == "3" ? 3 : 5;
                        }
                    }
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text { text: "Fetcher:"; color: #cdd6f4; vertical-alignment: center; }
                    ComboBox {
                        model: ["Direct  (recommended)", "Winget  (may require Entra ID)"];
                        current-index <=> root.fetcher;
                    }
                }

                Text {
                    text: "Direct downloads the MSIX from Microsoft's delivery CDN via the Store's own protocol. Winget shells out to winget.exe and currently requires a Microsoft Entra work/school account for Store packages.";
                    color: #6c7086;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }

            // Progress
            if root.current-screen == 4 : VerticalBox {
                spacing: 14px;
                Rectangle { vertical-stretch: 1; } // top spacer
                Text {
                    text: root.progress-phase;
                    color: #cdd6f4;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: 12px;
                    border-radius: 6px;
                    background: #313244;
                    Rectangle {
                        x: 0;
                        y: 0;
                        height: parent.height;
                        width: root.progress-indeterminate
                            ? parent.width * 0.3
                            : parent.width * root.progress-fraction;
                        border-radius: 6px;
                        background: #89b4fa;
                    }
                }
                Text {
                    text: root.progress-detail;
                    color: #a6adc8;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; } // bottom spacer
            }

            // Done
            if root.current-screen == 5 : VerticalBox {
                spacing: 10px;
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Codex is installed.";
                    color: #a6e3a1;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Version " + root.installed-version;
                    color: #cdd6f4;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.install-path;
                    color: #6c7086;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Error
            if root.current-screen == 6 : VerticalBox {
                spacing: 10px;
                Text {
                    text: "Installation failed";
                    color: #f38ba8;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: root.error-text;
                    color: #cdd6f4;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // Proxy status
            if root.current-screen == 10 : VerticalBox {
                spacing: 10px;
                Text { text: "Proxy mode"; color: #94e2d5; font-size: 14px; font-weight: 600; }
                Text { text: root.proxy-status; color: #a6adc8; font-size: 12px; wrap: word-wrap; }
            }

            // Checking for updates
            if root.current-screen == 11 : VerticalBox {
                spacing: 12px;
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Checking for updates…";
                    color: #cdd6f4;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: #313244;
                    Rectangle {
                        x: 0; y: 0;
                        height: parent.height;
                        width: parent.width * 0.3;
                        border-radius: 4px;
                        background: #89b4fa;
                    }
                }
                Text {
                    text: "Contacting the Microsoft Store…";
                    color: #a6adc8;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Update available
            if root.current-screen == 12 : VerticalBox {
                spacing: 10px;
                Text {
                    text: "A new version of Codex is available.";
                    color: #cdd6f4;
                    font-size: 15px;
                    font-weight: 600;
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 16px;
                    VerticalBox {
                        spacing: 2px;
                        padding: 0px;
                        Text { text: "Installed"; color: #6c7086; font-size: 11px; }
                        Text {
                            text: root.update-current-version;
                            color: #a6adc8;
                            font-size: 14px;
                        }
                    }
                    VerticalBox {
                        spacing: 2px;
                        padding: 0px;
                        Text { text: "Latest"; color: #6c7086; font-size: 11px; }
                        Text {
                            text: root.update-latest-version;
                            color: #a6e3a1;
                            font-size: 14px;
                            font-weight: 600;
                        }
                    }
                    Rectangle {}
                }
                Rectangle { height: 1px; background: #313244; }
                Text { text: "Don't update now?"; color: #6c7086; font-size: 11px; }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    DarkButton { text: "Remind next time"; clicked => { root.request-update(1); } }
                    DarkButton { text: "Snooze 1 day"; clicked => { root.request-update(3); } }
                    DarkButton { text: "Snooze 7 days"; clicked => { root.request-update(4); } }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    DarkButton { text: "Skip this version"; clicked => { root.request-update(2); } }
                    DarkButton { text: "Never check again"; clicked => { root.request-update(5); } }
                }
            }

            // Up to date
            if root.current-screen == 13 : VerticalBox {
                spacing: 10px;
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Codex is up to date.";
                    color: #a6e3a1;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Version " + root.update-current-version;
                    color: #a6adc8;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Uninstall: confirm
            if root.current-screen == 20 : VerticalBox {
                spacing: 12px;
                Text {
                    text: "Uninstall Codex?";
                    color: #cdd6f4;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "This will remove the launcher, Start Menu shortcut, and all installed versions of Codex.";
                    color: #a6adc8;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Your Codex logs and sign-in data will NOT be deleted.";
                    color: #94e2d5;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Uninstall: progress (reuses the same progress-* properties as screen 4)
            if root.current-screen == 21 : VerticalBox {
                spacing: 14px;
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: root.progress-phase;
                    color: #cdd6f4;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: 12px;
                    border-radius: 6px;
                    background: #313244;
                    Rectangle {
                        x: 0;
                        y: 0;
                        height: parent.height;
                        width: root.progress-indeterminate
                            ? parent.width * 0.3
                            : parent.width * root.progress-fraction;
                        border-radius: 6px;
                        background: #f38ba8;
                    }
                }
                Text {
                    text: root.progress-detail;
                    color: #a6adc8;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Uninstall: complete
            if root.current-screen == 22 : VerticalBox {
                spacing: 10px;
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Codex has been uninstalled.";
                    color: #a6e3a1;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.uninstall-log-path == "" ? "" : "Log: " + root.uninstall-log-path;
                    color: #6c7086;
                    font-size: 10px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Uninstall: error / refused
            if root.current-screen == 23 : VerticalBox {
                spacing: 10px;
                Text {
                    text: "Uninstall failed";
                    color: #f38ba8;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: root.error-text;
                    color: #cdd6f4;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // Launcher self-update prompt (screen 30) — informational, doesn't gate Codex.
            if root.current-screen == 30 : VerticalBox {
                spacing: 10px;
                Text {
                    text: "A new version of this launcher is available.";
                    color: #cdd6f4;
                    font-size: 15px;
                    font-weight: 600;
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 16px;
                    VerticalBox {
                        spacing: 2px;
                        padding: 0px;
                        Text { text: "Installed"; color: #6c7086; font-size: 11px; }
                        Text {
                            text: root.launcher-current-version;
                            color: #a6adc8;
                            font-size: 14px;
                        }
                    }
                    VerticalBox {
                        spacing: 2px;
                        padding: 0px;
                        Text { text: "Latest"; color: #6c7086; font-size: 11px; }
                        Text {
                            text: root.launcher-latest-version;
                            color: #a6e3a1;
                            font-size: 14px;
                            font-weight: 600;
                        }
                    }
                    Rectangle {}
                }
                Rectangle { height: 1px; background: #313244; }
                // Primary action row: update + view release notes.
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    DarkButton {
                        text: "Update launcher";
                        primary: true;
                        clicked => { root.request-launcher-action(6); }
                    }
                    DarkButton {
                        text: "Release notes";
                        clicked => { root.request-launcher-action(0); }
                    }
                    Rectangle {} // spacer pushes primary actions to the left
                }
                Rectangle { height: 4px; }
                // Defer row(s): muted, secondary group.
                Text { text: "Or defer"; color: #6c7086; font-size: 11px; }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    DarkButton { text: "Remind next time";  clicked => { root.request-launcher-action(1); } }
                    DarkButton { text: "Snooze 1 day";       clicked => { root.request-launcher-action(3); } }
                    DarkButton { text: "Snooze 7 days";      clicked => { root.request-launcher-action(4); } }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    DarkButton { text: "Skip this version";  clicked => { root.request-launcher-action(2); } }
                    DarkButton { text: "Never";              clicked => { root.request-launcher-action(5); } }
                }
            }

            // Launcher self-update succeeded (screen 31).
            if root.current-screen == 31 : VerticalBox {
                spacing: 10px;
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Launcher updated.";
                    color: #a6e3a1;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Version " + root.launcher-latest-version;
                    color: #cdd6f4;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Close this window to finish. The new launcher will be used the next time you start Codex.";
                    color: #a6adc8;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        // Footer nav
        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            // Back
            if root.current-screen >= 1 && root.current-screen <= 3 : DarkButton {
                text: "Back";
                clicked => { root.current-screen = root.current-screen - 1; }
            }
            Rectangle {} // spacer

            if root.current-screen == 0 : DarkButton {
                text: "Cancel";
                clicked => { root.request-quit(); }
            }
            if root.current-screen <= 3 && root.current-screen != 0 : DarkButton {
                text: "Cancel";
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 0 : DarkButton {
                text: "Next";
                primary: true;
                clicked => { root.current-screen = 1; }
            }
            if root.current-screen == 1 : DarkButton {
                text: "Next";
                primary: true;
                clicked => { root.current-screen = 2; }
            }
            if root.current-screen == 2 : DarkButton {
                text: "Next";
                primary: true;
                disabled: root.install-path == "";
                clicked => { root.current-screen = 3; }
            }
            if root.current-screen == 3 : DarkButton {
                text: "Install";
                primary: true;
                clicked => { root.current-screen = 4; root.request-install(); }
            }
            if root.current-screen == 5 : DarkButton {
                text: "Launch Codex";
                primary: true;
                clicked => { root.request-launch(); }
            }
            if root.current-screen == 5 : DarkButton {
                text: "Close";
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 6 : DarkButton {
                text: "Close";
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 10 : DarkButton {
                text: "Check for updates";
                clicked => { root.request-check-updates(); }
            }
            if root.current-screen == 10 : DarkButton {
                text: "Close";
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 12 : DarkButton {
                text: "Update now";
                primary: true;
                clicked => { root.request-update(0); }
            }
            if root.current-screen == 13 : DarkButton {
                text: "Close";
                clicked => { root.request-quit(); }
            }
            // Uninstall confirm
            if root.current-screen == 20 : DarkButton {
                text: "Cancel";
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 20 : DarkButton {
                text: "Uninstall";
                primary: true;
                clicked => { root.current-screen = 21; root.request-uninstall-start(); }
            }
            // Uninstall complete / error
            if root.current-screen == 22 : DarkButton {
                text: "Close";
                primary: true;
                clicked => { root.request-quit(); }
            }
            if root.current-screen == 23 : DarkButton {
                text: "Close";
                clicked => { root.request-quit(); }
            }
            // Launcher self-update done
            if root.current-screen == 31 : DarkButton {
                text: "Close";
                primary: true;
                clicked => { root.request-quit(); }
            }
        }

        // Slint Royalty-Free 2.0 attribution. Required to be visible during
        // normal use of the application. Placed in the window chrome so it
        // shows on every screen (installer, proxy splash, uninstall).
        Text {
            text: "Made with Slint";
            color: #45475a;
            font-size: 10px;
            horizontal-alignment: right;
        }
    }
}
